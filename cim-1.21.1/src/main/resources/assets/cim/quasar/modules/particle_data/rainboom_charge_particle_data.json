{
	"render_style": "cim:charge_cone",
	"should_collide": false,
	"face_velocity": false,
	"additive": false,
	"modules": [
		{
			"module": "size",
			"size": "1.0 + q.agePercent * 1.5"
		},
		{
			"module": "color",
			"gradient": {
				"rgb_points": [
					{ "percent": 0.0, "color": [255, 255, 255] }
				],
				"alpha_points": [
					{ "percent": 0.0, "alpha": 0.0 },
					{ "percent": 1.0, "alpha": 1.0 }
				]
			},
			"interpolant": "q.agePercent"
		}
	]
}
